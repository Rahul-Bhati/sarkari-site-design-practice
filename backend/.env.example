# Copy to backend/.env and fill in. Never commit the real file.

# --- Required to boot ---
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...              # Service role key (full access, bypasses RLS)

# --- AI ---
# "groq" = free tier, no credit card, fastest. "gemini" = also free.
# "anthropic" = better summaries, paid.
AI_PROVIDER=groq

# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b           # strict JSON schema + good Devanagari

# Only needed when AI_PROVIDER=gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite       # free tier: 1,000 requests/day, 15/min
GEMINI_DISABLE_THINKING=true

# Only needed when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

AI_DAILY_CAP_INR=500                     # rupee cap; only bites on paid providers
AI_DAILY_REQUEST_CAP=900                 # guards the free tier's requests/day
AI_BATCH_SIZE=10
AI_AUTO_APPROVE_CONFIDENCE=0.90

# --- Notifications ---
RESEND_API_KEY=re_xxx
RESEND_FROM=SarkariSaar <updates@sarkarisaar.com>
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=SarkariSaar
GUPSHUP_SOURCE_NUMBER=            # WhatsApp Business number, digits only
GUPSHUP_DAILY_LIMIT=1000

# --- Payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_THEKEDAR_MONTHLY=
RAZORPAY_PLAN_THEKEDAR_YEARLY=

# --- Cache ---
UPSTASH_REDIS_URL=                # Optional; falls back to in-process cache
FEED_CACHE_TTL_SECONDS=300

# --- Ops ---
SENTRY_DSN=
ADMIN_API_KEY=                    # Generate: openssl rand -hex 32
SCHEDULER_ENABLED=true

# --- App ---
ENVIRONMENT=development           # development | staging | production
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
