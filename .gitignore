# Secrets — never commit these.
# Catch-all rather than a list: .env.bak, .env.prod and friends get created by
# accident and are just as sensitive as .env itself.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs and scratch
*.log
/tmp/
coverage/
.coverage
htmlcov/
